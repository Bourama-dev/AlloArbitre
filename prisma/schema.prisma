// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native" pour le dev local, "rhel-openssl-3.0.x" pour le runtime Node.js
  // des fonctions serverless Vercel (sinon le moteur binaire est introuvable
  // au déploiement : PrismaClientInitializationError en production).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// url/directUrl utilisent les noms fournis par l'intégration Vercel-Supabase
// (synchronisés automatiquement dans les variables d'environnement du
// projet Vercel une fois le projet Supabase connecté).
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  ADMIN
  REPARTITEUR
}

/// Profil applicatif (nom, rôle) d'un utilisateur Supabase Auth.
/// id = auth.users.id (FK gérée en SQL brut, hors Prisma - voir migration
/// et note dans le schéma sur les schémas gérés par Supabase). Une ligne
/// est créée automatiquement par un trigger à l'inscription (handle_new_user).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(REPARTITEUR)
  createdAt DateTime @default(now())

  designations Designation[]
}

/// Niveau d'arbitre (ex: Jeune Arbitre, District 3, District 2, District 1...).
/// rank croissant = niveau plus élevé. Éditable pour coller à la grille réelle du CD45.
model RefereeLevel {
  id    String @id @default(cuid())
  label String @unique
  rank  Int    @unique

  referees        Referee[]
  levelMappings   LevelMapping[]
}

model Referee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  zone      String?
  active    Boolean  @default(true)
  notes     String?

  levelId String
  level   RefereeLevel @relation(fields: [levelId], references: [id])

  designations Designation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Niveau de compétition (ex: Seniors D1, U18, Coupe départementale...).
model CompetitionLevel {
  id    String @id @default(cuid())
  label String @unique

  matches Match[]
  mapping LevelMapping?
}

/// Correspondance niveau de compétition -> niveau d'arbitre minimum requis.
/// Table éditable (voir /admin/niveaux) pour ne jamais dépendre d'une valeur figée dans le code.
model LevelMapping {
  id                 String @id @default(cuid())
  competitionLevelId String @unique
  competitionLevel   CompetitionLevel @relation(fields: [competitionLevelId], references: [id], onDelete: Cascade)

  minRefereeLevelId String
  minRefereeLevel   RefereeLevel @relation(fields: [minRefereeLevelId], references: [id])
}

model Match {
  id                 String   @id @default(cuid())
  date               DateTime
  durationMinutes    Int      @default(100)
  homeTeam           String
  awayTeam           String
  venue              String?
  refereesRequired   Int      @default(1)
  cancelled          Boolean  @default(false)

  competitionLevelId String
  competitionLevel   CompetitionLevel @relation(fields: [competitionLevelId], references: [id])

  designations Designation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Désignation d'un arbitre sur un match. Toujours créée après validation manuelle
/// d'une suggestion - jamais d'auto-assignation silencieuse.
model Designation {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  refereeId String
  referee   Referee  @relation(fields: [refereeId], references: [id])

  createdById String  @db.Uuid
  createdBy   Profile @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([matchId, refereeId])
}
